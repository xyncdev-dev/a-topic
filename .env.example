# ─── Database ──────────────────────────────────────────────────
# PostgreSQL is used automatically in production (Vercel) when DATABASE_URL
# is set. If it is not set, SQLite is used for local development.
DATABASE_URL=postgresql://user:password@host:5432/atopic?sslmode=require

# Optional: custom SQLite file location (defaults to apps/api/data/rewards.db)
# SQLITE_FILENAME=./data/rewards.db

# ─── Shopify Configuration ─────────────────────────────────────
SHOPIFY_STORE_URL=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxx
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here

# ─── Authentication ────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_change_this_in_production
# Optional: JWT expiration (defaults to 24h)
# JWT_EXPIRES_IN=24h

# ─── Coins Configuration ───────────────────────────────────────
COINS_MULTIPLIER=10

# ─── API Configuration ─────────────────────────────────────────
API_PORT=3001
CORS_ORIGIN=http://localhost:3000

# ─── Frontend (Next.js) ────────────────────────────────────────
# In production (Vercel) point this to your deployed domain, e.g.:
# NEXT_PUBLIC_API_URL=https://your-app.vercel.app/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api
